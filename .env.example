# ============================================================
# Подхват AI+ — переменные окружения (единый файл на весь проект)
# Фронтенд (Vite/Vercel) — переменные VITE_* и функция api/lead.
# Бэкенд (VPS, Этап B) — секреты GigaChat/Novofon/SMS/JWT.
# В git попадает ТОЛЬКО этот пример; сам .env — в .gitignore.
# ============================================================

# ---------- Сайт-витрина (сборка Vite, префикс VITE_ — попадают в бандл) ----------
# Каноничный домен (по умолчанию podhvatplus.ru)
VITE_SITE_DOMAIN=podhvatplus.ru
# Telegram-username основателя без @ (кнопки «написать основателю»). Пусто — показывается плейсхолдер.
VITE_TG_USERNAME=
# Ссылка на приложение в RuStore (приложение ещё не опубликовано). Пусто — плейсхолдер + QR от плейсхолдера.
VITE_RUSTORE_URL=
# Счётчик Яндекс.Метрики. Пусто — цели логируются в консоль, счётчик не подключается.
VITE_YM_ID=
# Синоним имени счётчика (мастер-Решения). Достаточно задать один из VITE_YM_ID / VITE_METRIKA_ID.
VITE_METRIKA_ID=
# Куда слать заявку формы. Пусто — используется serverless-функция /api/lead (см. ниже).
VITE_LEAD_WEBHOOK_URL=
# База API бэкенда для кабинета /app (Этап B). На Этапе A не нужна.
VITE_API_BASE=

# ---------- Serverless-функция Vercel api/lead.js (заявка → Telegram владельцу) ----------
# Токен бота-приёмщика заявок (может быть тот же, что и Штаб-бот) от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAE...
# Chat ID, куда падают заявки с сайта (личка владельца или группа)
TELEGRAM_CHAT_ID=123456789

# ============================================================
# Backend (VPS) — Этап B. (Значения ниже — из текущего backend-ядра «Подхват».)
# ============================================================

# === Telegram ===
# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAE...
# Ваш личный Telegram ID (владелец): сюда приходят сводки и ошибки.
# Узнать свой ID: @userinfobot
OWNER_TG_ID=123456789
# Клиника по умолчанию, если пациент открыл бота без deep-link
DEFAULT_CLINIC_SLUG=demo-dent

# === GigaChat (developers.sber.ru) ===
# Authorization Key из личного кабинета (значение поля «Авторизационные данные»)
GIGACHAT_CREDENTIALS=NjE...==
# Скоуп: GIGACHAT_API_PERS (физлицо) | GIGACHAT_API_B2B | GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель (лёгкая и дешёвая для диалогов записи)
GIGACHAT_MODEL=GigaChat-2
# Путь к сертификату НУЦ Минцифры (вариант А из README).
# Оставьте пустым, если русские сертификаты установлены в систему (вариант Б).
GIGACHAT_CA_BUNDLE_FILE=/app/certs/russian_trusted_root_ca.cer
# Крайняя мера для локальной отладки: false отключает проверку TLS. В проде — true!
GIGACHAT_VERIFY_SSL=true
# Цена за 1000 токенов в ₽ — для расчёта расхода в дайджесте владельцу
GIGACHAT_RUB_PER_1K_TOKENS=0.2

# === SMS Aero (smsaero.ru) — текущий провайдер ядра ===
# ПРИМЕЧАНИЕ: спецификация Этапа B требует адаптер под SMS.ru; будет добавлен в channels/channel_sms.py.
SMSAERO_EMAIL=you@example.com
SMSAERO_API_KEY=abcdef123456

# === Novofon (вебхук пропущенных звонков) ===
# Секрет, который вы добавляете в URL вебхука: /webhook/novofon?secret=...
NOVOFON_WEBHOOK_SECRET=длинная-случайная-строка
# API-секрет из кабинета my.novofon.com/api — включает проверку подписи
# Signature на каждом вебхуке (опционально, но рекомендуется)
NOVOFON_API_SECRET=

# === Приложение ===
# Домен для Caddy (TLS Let's Encrypt); должен совпадать с PUBLIC_BASE_URL
DOMAIN=bot.example.ru
# Публичный URL (домен с Caddy) — для сниппета виджета
PUBLIC_BASE_URL=https://bot.example.ru
# Username бота без @ — используется scripts/add_clinic.py для печати ссылок
BOT_USERNAME=your_bot
DB_PATH=data/podkhvat.db
LOG_LEVEL=INFO

# === Этап B: кабинет владельца, каналы, лимиты ===
# JWT-secret для magic-link/сессий кабинета. НА ПРОДЕ генерируется setup.sh
# (openssl rand -hex 32) — не оставляйте значение по умолчанию.
JWT_SECRET=
JWT_DAYS=30
# SMS.ru — провайдер SMS по ТЗ Этапа B (режим «мост»). api_id из личного кабинета.
SMSRU_API_ID=
# MAX (dev.max.ru) — адаптер-заглушка в этой версии; токен пока не обязателен.
MAX_BOT_TOKEN=
# Отдельный Штаб-бот (вход/карточки/отчёты). Пусто → используется BOT_TOKEN.
SHTAB_BOT_TOKEN=
# CORS-origin кабинета на Vercel (например https://podhvatplus.ru). * — любой.
CABINET_ORIGIN=https://podhvatplus.ru
# Лимиты защиты от перерасхода
SMS_DAILY_LIMIT=100
TELEPHONY_PER_MIN=5
