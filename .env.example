# === Telegram ===
# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAE...
# Ваш личный Telegram ID (владелец): сюда приходят сводки и ошибки.
# Узнать свой ID: @userinfobot
OWNER_TG_ID=123456789
# Клиника по умолчанию, если пациент открыл бота без deep-link
DEFAULT_CLINIC_SLUG=demo-dent

# === GigaChat (developers.sber.ru) ===
# Authorization Key из личного кабинета (значение поля «Авторизационные данные»)
GIGACHAT_CREDENTIALS=NjE...==
# Скоуп: GIGACHAT_API_PERS (физлицо) | GIGACHAT_API_B2B | GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель (лёгкая и дешёвая для диалогов записи)
GIGACHAT_MODEL=GigaChat-2
# Путь к сертификату НУЦ Минцифры (вариант А из README).
# Оставьте пустым, если русские сертификаты установлены в систему (вариант Б).
GIGACHAT_CA_BUNDLE_FILE=/app/certs/russian_trusted_root_ca.cer
# Крайняя мера для локальной отладки: false отключает проверку TLS. В проде — true!
GIGACHAT_VERIFY_SSL=true
# Цена за 1000 токенов в ₽ — для расчёта расхода в дайджесте владельцу
GIGACHAT_RUB_PER_1K_TOKENS=0.2

# === SMS Aero (smsaero.ru) ===
SMSAERO_EMAIL=you@example.com
SMSAERO_API_KEY=abcdef123456

# === Novofon (вебхук пропущенных звонков) ===
# Секрет, который вы добавляете в URL вебхука: /webhook/novofon?secret=...
NOVOFON_WEBHOOK_SECRET=длинная-случайная-строка
# API-секрет из кабинета my.novofon.com/api — включает проверку подписи
# Signature на каждом вебхуке (опционально, но рекомендуется)
NOVOFON_API_SECRET=

# === Приложение ===
# Домен для Caddy (TLS Let's Encrypt); должен совпадать с PUBLIC_BASE_URL
DOMAIN=bot.example.ru
# Публичный URL (домен с Caddy) — для сниппета виджета
PUBLIC_BASE_URL=https://bot.example.ru
# Username бота без @ — используется scripts/add_clinic.py для печати ссылок
BOT_USERNAME=your_bot
DB_PATH=data/podkhvat.db
LOG_LEVEL=INFO

# === Кабинет и безопасность ===
# Секрет подписи JWT-сессий кабинета. ОБЯЗАТЕЛЬНО длинная случайная строка на проде
# (setup.sh генерирует автоматически). В деве можно оставить дефолт.
JWT_SECRET=change-me-to-a-long-random-string
# Флаг Secure у cookie сессии. В проде (HTTPS) — true. Для локальной dev-разработки
# по http (фронт :5173 через Vite-прокси на backend :8000) поставьте false.
COOKIE_SECURE=true
# Суточный потолок исходящих SMS на клинику (защита баланса от бага/атаки)
SMS_DAILY_CAP_PER_CLINIC=200
# Примечание: персональный токен вебхука телефонии задаётся per-clinic в
# app/clinics/<slug>.yaml полем clinic_token и подставляется в URL вебхука:
#   /webhook/novofon?clinic_token=<token>

