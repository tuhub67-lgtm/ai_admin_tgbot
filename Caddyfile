# Домен берётся из переменной DOMAIN (docker-compose.yml).
# Caddy сам получает и продлевает TLS-сертификат Let's Encrypt.
{$DOMAIN} {
	encode gzip

	# Виджет для сайтов клиник — раздаём статикой с длинным кэшем
	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=3600"
		header Access-Control-Allow-Origin "*"
		file_server
	}

	# API виджета и вебхуки Novofon — проксируем в приложение
	handle /api/* {
		reverse_proxy app:8000
	}
	handle /webhook/* {
		reverse_proxy app:8000
	}
	handle /health {
		reverse_proxy app:8000
	}

	# Всё остальное — SPA (витрина «/», кабинет «/app», «/privacy»).
	# try_files с фолбэком на index.html: клиентские маршруты рендерит React.
	handle {
		root * /srv/app
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
