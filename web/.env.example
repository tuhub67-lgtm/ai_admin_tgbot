# Витрина «Подхват AI+» — переменные сборки (Vite). Пусто → безопасные дефолты.

# Яндекс.Метрика: номер счётчика. Пусто — Метрика не подключается.
VITE_METRIKA_ID=

# Куда отправлять заявку с формы. Пусто — заявка только логируется (см. LeadForm).
# В ЭТАПЕ B укажите путь бэкенда: /api/public/lead-request
VITE_LEAD_WEBHOOK_URL=

# Telegram основателя (для блока доверия и футера), с @ или без.
VITE_FOUNDER_TG=@podhvat_osnovatel

# Deep-link входа в кабинет через Telegram-бот (кнопка «Войти»).
VITE_BOT_LOGIN_URL=https://t.me/podhvat_bot?start=login

# Ссылка на приложение в RuStore (вторичный CTA + QR).
VITE_RUSTORE_URL=

# Контактный e-mail в футере.
VITE_CONTACT_EMAIL=hello@podhvat.ru
